 {% block scripts %}
 <script>
     // ===== Hide completed =====
     const hideCompleted = document.getElementById('hideCompleted');
     const taskRows = Array.from(document.querySelectorAll('#tasksTable tbody .task-row'));

     function applyHideCompleted() {
         const hide = hideCompleted && hideCompleted.checked;
         taskRows.forEach(r => {
             const st = (r.dataset.status || '').toLowerCase();
             r.style.display = (hide && st === 'done') ? 'none' : '';
         });
     }

     if (hideCompleted) hideCompleted.addEventListener('change', applyHideCompleted);

     // ===== Popover (hard-styled via JS: works even if CSS is cached/old) =====
     const pop = document.createElement('div');
     pop.className = 'desc-pop';

     // hard overlay styles
     pop.style.position = 'fixed';
     pop.style.inset = '0';
